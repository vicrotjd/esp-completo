-- ============================================================
-- PER-PLAYER DRAWING REGISTRY
-- ============================================================
local esp = {}

local function ensureEsp(plr)
    if esp[plr] then return esp[plr] end
    local e = {
        box2d    = newDrawing("Square", { Thickness = 1, Filled = false, Visible = false, Color = Config.BoxColor }),
        boxFill  = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Config.BoxColor, Transparency = 0.75 }),
        box3d    = {},
        skeleton = {},
        line     = newDrawing("Line",   { Thickness = 1, Visible = false, Color = Config.LineColor }),
        hpV      = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false }),
        hpVbg    = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Color3.new(0,0,0) }),
        hpH      = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false }),
        hpHbg    = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Color3.new(0,0,0) }),
        headDot  = newDrawing("Circle", { Thickness = 1, Filled = true,  Visible = false, Color = Config.BoxColor }),
        name     = newDrawing("Text",   { Size = Config.TextSize, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.NameColor, Transparency = Config.TextTransparency }),
        dist     = newDrawing("Text",   { Size = Config.TextSize, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
        distX    = newDrawing("Text",   { Size = Config.TextSize - 2, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
        distZ    = newDrawing("Text",   { Size = Config.TextSize - 2, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
    }
    esp[plr] = e
    return e
end

local function clearEsp(plr)
    local e = esp[plr]
    if not e then return end
    for _, v in pairs(e) do
        if typeof(v) == "Drawing" then v:Remove()
        elseif type(v) == "table" then
            for _, l in pairs(v) do if typeof(l) == "Drawing" then l:Remove() end end
        end
    end
    esp[plr] = nil
end

local function hideAll(e)
    if not e then return end
    for _, v in pairs(e) do
        if typeof(v) == "Drawing" then v.Visible = false
        elseif type(v) == "table" then
            for _, l in pairs(v) do if typeof(l) == "Drawing" then l.Visible = false end end
        end
    end
end

-- ============================================================
-- AIMBOT LOGIC
-- ============================================================
local isAiming = false
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Config.AimKey then isAiming = true end
end)
UIS.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Config.AimKey then isAiming = false end
end)

local function getClosestPlayerToMouse()
    local closest = nil
    local shortestDist = Config.AimFOV
    local mousePos = UIS:GetMouseLocation()

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char, hrp, head, hum = getCharacterParts(plr)
            if char and (not Config.TeamCheck or plr.Team ~= LocalPlayer.Team) then
                local targetPart = Config.AimPart == "Head" and head or hrp
                local screenPos = screenPoint(targetPart.Position)

                if screenPos then
                    local dist = (mousePos - screenPos).Magnitude
                    if dist < shortestDist then
                        if Config.AimWallCheck then
                            local ray = Ray.new(Camera.CFrame.Position, (targetPart.Position - Camera.CFrame.Position).Unit * 2000)
                            local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character})
                            if hit and hit:IsDescendantOf(char) then
                                closest = {plr = plr, pos = targetPart.Position, part = targetPart}
                                shortestDist = dist
                            end
                        else
                            closest = {plr = plr, pos = targetPart.Position, part = targetPart}
                            shortestDist = dist
                        end
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    if not Config.Enabled or not Config.AimEnabled or not isAiming then return end
    local target = getClosestPlayerToMouse()
    if target then
        local camPos = Camera.CFrame.Position
        local targetPos = target.pos

        if Config.AimPrediction > 0 and target.part then
            local velocity = target.part.AssemblyLinearVelocity
            targetPos = targetPos + (velocity * Config.AimPrediction)
        end

        local newCFrame = CFrame.lookAt(camPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, 1 - Config.AimSmooth)
    end
end)

