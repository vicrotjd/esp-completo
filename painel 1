-- ============================================================
-- DRAWING HELPERS
-- ============================================================
local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props or {}) do d[k] = v end
    return d
end

local function healthColor(frac)
    frac = math.clamp(frac, 0, 1)
    return Color3.new(1 - frac, frac, 0)
end

local function getCharacterParts(plr)
    local char = plr.Character
    if not char then return nil end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and head and hum) then return nil end
    if hum.Health <= 0 then return nil end
    return char, hrp, head, hum
end

local function visible(plr, hrp)
    if not Config.VisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local dir    = hrp.Position - origin
    local ray    = Ray.new(origin, dir)
    local hit    = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, hrp.Parent})
    return hit == nil or hit.Parent == hrp.Parent or hit:IsDescendantOf(hrp.Parent)
end

local function screenPoint(pos)
    local sp, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen then return nil end
    local vp = Camera.ViewportSize
    if sp.X < 0 or sp.X > vp.X or sp.Y < 0 or sp.Y > vp.Y then return nil end
    return Vector2.new(sp.X, sp.Y)
end

