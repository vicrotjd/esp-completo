local found = 0

local function scanFolder(folder)
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = string.lower(obj.Name)
            -- Filtro mais amplo pra achar o que interessa
            if string.find(name, "spin") or string.find(name, "roll") or string.find(name, "gacha") or string.find(name, "lucky") or string.find(name, "roulette") then
                found = found + 1
                local class = obj:IsA("RemoteEvent") and "RemoteEvent (FireServer)" or "RemoteFunction (InvokeServer)"
                print(string.format("[%d] NOME: %s", found, obj.Name))
                print(string.format("    CAMINHO: %s", obj:GetFullName()))
                print(string.format("    CLASSE: %s", class))
                print("----------------------------------------")
            end
        end
    end
end

