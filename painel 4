-- Volleyball Legends - Lucky Spin Auto (3/s) Bypass Attempt
-- Load: execute no Xeno. Requer estar na tela do Lucky Spin (gacha).
-- Se tomar kick, o script tenta rejoin automatico.

if _G.VL_SpinFarm then
    pcall(function() _G.VL_SpinFarm:Destroy() end)
    _G.VL_SpinFarm = nil
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LP = Players.LocalPlayer
local SPIN_DELAY = 0.33 -- 3 spins por segundo
local running = true
local spinRemote = nil
local spinArgs = nil

-- 1. Encontrar o RemoteEvent de Spin
local function findSpinRemote()
    -- Procura remotes com "spin" ou "roll" no nome
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = string.lower(obj.Name)
            if string.find(name, "spin") or string.find(name, "roll") or string.find(name, "gacha") then
                return obj
            end
        end
    end
    -- Se nao achar direto, procura em pastas comuns de remotes
    local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("RemoteEvents")
    if remotes then
        for _, obj in ipairs(remotes:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local name = string.lower(obj.Name)
                if string.find(name, "spin") or string.find(name, "roll") or string.find(name, "gacha") then
                    return obj
                end
            end
        end
    end
    return nil
end

spinRemote = findSpinRemote()

if not spinRemote then
    warn("[Mica Spin] Remote de Spin nao encontrado. Abra a tela do Lucky Spin e tente de novo.")
    return
end

print("[Mica Spin] Remote encontrado: " .. spinRemote:GetFullName())

-- 2. Tentar descobrir argumentos
-- Muitos jogos usam um argumento numerico (quantidade) ou booleano (usar gema).
-- Vamos tentar nil primeiro, depois 1, depois true.
local argAttempts = {nil, 1, true, "Spin"}

-- 3. Loop de disparo
local function fireSpin()
    if not running or not spinRemote then return end
    
    local success = false
    for _, arg in ipairs(argAttempts) do
        local ok, err = pcall(function()
            if arg == nil then
                spinRemote:FireServer()
            else
                spinRemote:FireServer(arg)
            end
        end)
        if ok then
            success = true
            break
        end
    end
    
    if not success then
        -- Se falhar 5 vezes seguidas, tenta redescobrir o remote
        print("[Mica Spin] Falha no fire. Redescobrindo remote...")
        spinRemote = findSpinRemote()
    end
end

-- 4. Executa a cada 0.33s
local conn = RunService.Heartbeat:Connect(function()
    if not running then return end
    fireSpin()
    task.wait(SPIN_DELAY)
end)

-- 5. Anti-kick / Auto-rejoin (opcional, mas util se o jogo kickar)
local function onKick()
    if not running then return end
    print("[Mica Spin] Kick detectado. Tentando rejoin em 2s...")
    task.wait(2)
    game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
end

-- Monitoramento de erro de kick
game:GetService("Players").LocalPlayer.OnTeleport:Connect(function(state)
    if state == Enum.TeleportState.Failed then
        onKick()
    end
end)

-- 6. Cleanup
_G.VL_SpinFarm = {
    Destroy = function()
        running = false
        if conn then conn:Disconnect() end
        print("[Mica Spin] Desligado.")
    end
}

print("[Mica Spin] Ativo. 3 spins/s. Use _G.VL_SpinFarm:Destroy() pra parar.")
