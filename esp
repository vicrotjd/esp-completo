-- language: Lua, target: Roblox executor (e.g. Synapse X, KRNL, Fluxus)
-- features: speed, fly, noclip, infinite jump | toggle via keybinds

local Players        = game:GetService("Players")
local RunService     = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp            = Players.LocalPlayer
local char, root, hum

local cfg = {
    speed       = 50,
    flySpeed    = 40,
    jumpPower   = 100,
    keys = {
        fly      = Enum.KeyCode.F,
        noclip   = Enum.KeyCode.N,
        speed    = Enum.KeyCode.X,
        infjump  = Enum.KeyCode.J,
    }
}

local state = { fly = false, noclip = false, speed = false, infjump = false }

local function getChar()
    char = lp.Character or lp.CharacterAdded:Wait()
    root = char:WaitForChild("HumanoidRootPart")
    hum  = char:WaitForChild("Humanoid")
end

getChar()
lp.CharacterAdded:Connect(getChar)

-- SPEED
local function setSpeed(on)
    if hum then
        hum.WalkSpeed = on and cfg.speed or 16
    end
end

-- INFINITE JUMP
UserInputService.JumpRequest:Connect(function()
    if state.infjump and hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- FLY
local flyConn
local function startFly()
    if flyConn then flyConn:Disconnect() end
    local bp = Instance.new("BodyVelocity", root)
    bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bp.Velocity = Vector3.zero
    local ba = Instance.new("BodyAngularVelocity", root)
    ba.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    ba.AngularVelocity = Vector3.zero

    flyConn = RunService.Heartbeat:Connect(function()
        if not state.fly then
            bp:Destroy(); ba:Destroy()
            flyConn:Disconnect()
            return
        end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
        bp.Velocity = dir.Magnitude > 0 and dir.Unit * cfg.flySpeed or Vector3.zero
    end)
end

-- NOCLIP
RunService.Stepped:Connect(function()
    if state.noclip and char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end)

-- TOGGLES
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local k = inp.KeyCode

    if k == cfg.keys.speed then
        state.speed = not state.speed
        setSpeed(state.speed)

    elseif k == cfg.keys.fly then
        state.fly = not state.fly
        if state.fly then
            hum:ChangeState(Enum.HumanoidStateType.Physics)
            startFly()
        else
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

    elseif k == cfg.keys.noclip then
        state.noclip = not state.noclip

    elseif k == cfg.keys.infjump then
        state.infjump = not state.infjump
        if hum then
            hum.JumpPower = state.infjump and cfg.jumpPower or 50
        end
    end
end)
