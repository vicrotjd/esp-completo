    end

    -- toggle row
    local function toggleRow(label, key, order)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 28)
        row.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
        row.BorderSizePixel = 0
        row.LayoutOrder = order
        row.Parent = body
        local rc = Instance.new("UICorner", row)
        rc.CornerRadius = UDim.new(0, 5)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -50, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 38, 0, 18)
        btn.Position = UDim2.new(1, -46, 0.5, -9)
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(60, 60, 70)
        btn.Text = Config[key] and "ON" or "OFF"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.BorderSizePixel = 0
        btn.Parent = row
        local bc = Instance.new("UICorner", btn)
        bc.CornerRadius = UDim.new(0, 9)

        btn.MouseButton1Click:Connect(function()
            Config[key] = not Config[key]
            btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(60, 60, 70)
            btn.Text = Config[key] and "ON" or "OFF"
        end)

        return row, btn
    end

    -- slider row
    local function sliderRow(label, key, minVal, maxVal, order)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 40)
        row.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
        row.BorderSizePixel = 0
        row.LayoutOrder = order
        row.Parent = body
        local rc = Instance.new("UICorner", row)
        rc.CornerRadius = UDim.new(0, 5)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -20, 0, 16)
        lbl.Position = UDim2.new(0, 10, 0, 2)
        lbl.BackgroundTransparency = 1
        lbl.Text = label .. ": " .. tostring(Config[key])
        lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row

        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -20, 0, 5)
        track.Position = UDim2.new(0, 10, 0, 24)
        track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        track.BorderSizePixel = 0
        track.Parent = row
        local tc = Instance.new("UICorner", track)
        tc.CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new((Config[key] - minVal) / (maxVal - minVal), 0, 1, 0)
        fill.BackgroundColor3 = Config.PanelAccent
        fill.BorderSizePixel = 0
        fill.Parent = track
        local fc = Instance.new("UICorner", fill)
        fc.CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function setFromX(mx)
            local abs = track.AbsolutePosition.X
            local w   = track.AbsoluteSize.X
            local f   = math.clamp((mx - abs) / w, 0, 1)
            local v   = math.floor(minVal + f * (maxVal - minVal))
            Config[key] = v
            lbl.Text = label .. ": " .. tostring(v)
            fill.Size = UDim2.new(f, 0, 1, 0)
        end

        track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; setFromX(inp.Position.X)
            end
        end)
        UIS.InputChanged:Connect(function(inp)
            if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
                setFromX(inp.Position.X)
            end
        end)
        UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

    -- build rows
    local order = 0
    section("Render", order); order += 1
    toggleRow("Box 2D",          "Box2D",             order); order += 1
    toggleRow("Fill Box",        "FillBox",           order); order += 1
    toggleRow("Box 3D",          "Box3D",             order); order += 1
    toggleRow("Skeleton",        "Skeleton",          order); order += 1
    toggleRow("Tracers (Line)",  "Line",              order); order += 1
    toggleRow("Head Dot",        "HeadDot",           order); order += 1

    section("Info", order); order += 1
    toggleRow("Name Tag",        "NameTag",           order); order += 1
    toggleRow("Distance Total",  "DistanceText",      order); order += 1
    toggleRow("Distance X/Z",    "DistanceAxes",      order); order += 1
    toggleRow("Health Vertical", "HealthBarVertical", order); order += 1
    toggleRow("Health Horizontal","HealthBarHorizontal", order); order += 1

    section("Filters", order); order += 1
    toggleRow("Team Check",      "TeamCheck",         order); order += 1
    toggleRow("Visibility Check","VisibleCheck",      order); order += 1
    sliderRow("Max Distance",    "MaxDistance",  100, 5000, order); order += 1

    -- MASTER toggle handler
    local function paintMaster()
        master.Text = Config.Enabled and "ON" or "OFF"
        master.BackgroundColor3 = Config.Enabled and Color3.fromRGB(0, 170, 80) or Color3.fromRGB(60, 60, 70)
    end
    master.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        paintMaster()
    end)

    -- COLLAPSE
    local collapsed = false
    local fullSize  = UDim2.new(0, 260, 0, 420)
    local smallSize = UDim2.new(0, 260, 0, 36)
    collapse.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        Tween:Create(main, TweenInfo.new(0.2), {Size = collapsed and smallSize or fullSize}):Play()
        body.Visible = not collapsed
        collapse.Text = collapsed and "+" or "–"
    end)

    -- DRAG
    local dragging, dragStart, startPos
    header.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = inp.Position
            startPos  = main.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = inp.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return gui
end

-- ============================================================
-- LOOP
-- ============================================================
local function cleanupAll()
    for plr in pairs(esp) do clearEsp(plr) end
    esp = {}
end

local renderConn = RunService.RenderStepped:Connect(function()
    if not Config.Enabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        pcall(renderPlayer, plr)
    end
end)

local removeConn = Players.PlayerRemoving:Connect(function(plr) clearEsp(plr) end)

-- ============================================================
-- SELF-CLEANUP ON RE-EXECUTE
-- ============================================================
if _G.__mica_dyy__ then
    pcall(function()
        if _G.__mica_dyy__.gui        then _G.__mica_dyy__.gui:Destroy() end
        if _G.__mica_dyy__.renderConn then _G.__mica_dyy__.renderConn:Disconnect() end
        if _G.__mica_dyy__.removeConn then _G.__mica_dyy__.removeConn:Disconnect() end
        _G.__mica_dyy__.cleanup()
    end)
end

local gui = buildPanel()

_G.__mica_dyy__ = {
    gui        = gui,
    renderConn = renderConn,
    removeConn = removeConn,
    cleanup    = cleanupAll,
    config     = Config,
}
