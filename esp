-- ============================================================
-- DRAWING HELPERS
-- ============================================================
local function newDrawing(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props or {}) do d[k] = v end
    return d
end

local function clearDrawing(t)
    if not t then return end
    for _, v in pairs(t) do
        if typeof(v) == "Drawing" then v:Remove() end
    end
end

local function healthColor(frac)
    frac = math.clamp(frac, 0, 1)
    return Color3.new(1 - frac, frac, 0)
end

local function getCharacterParts(plr)
    local char = plr.Character
    if not char then return nil end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not (hrp and head and hum) then return nil end
    if hum.Health <= 0 then return nil end
    return char, hrp, head, hum
end

local function visible(plr, hrp)
    if not Config.VisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local dir    = hrp.Position - origin
    local ray    = Ray.new(origin, dir)
    local hit    = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, hrp.Parent})
    return hit == nil or hit.Parent == hrp.Parent or hit:IsDescendantOf(hrp.Parent)
end

local function screenPoint(pos)
    local sp, onScreen = Camera:WorldToViewportPoint(pos)
    if not onScreen then return nil end
    return Vector2.new(sp.X, sp.Y)
end

local SKEL_R6 = {
    {"Head","Torso"},{"Torso","HumanoidRootPart"},
    {"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},
}
local SKEL_R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}

-- ============================================================
-- PER-PLAYER DRAWING REGISTRY
-- ============================================================
local esp = {}

local function ensureEsp(plr)
    if esp[plr] then return esp[plr] end
    local e = {
        box2d    = newDrawing("Square", { Thickness = 1, Filled = false, Visible = false, Color = Config.BoxColor }),
        boxFill  = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Config.BoxColor, Transparency = 0.75 }),
        box3d    = {},
        skeleton = {},
        line     = newDrawing("Line",   { Thickness = 1, Visible = false, Color = Config.LineColor }),
        hpV      = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false }),
        hpVbg    = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Color3.new(0,0,0) }),
        hpH      = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false }),
        hpHbg    = newDrawing("Square", { Thickness = 1, Filled = true,  Visible = false, Color = Color3.new(0,0,0) }),
        headDot  = newDrawing("Circle", { Thickness = 1, Filled = true,  Visible = false, Color = Config.BoxColor }),
        name     = newDrawing("Text",   { Size = Config.TextSize, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.NameColor, Transparency = Config.TextTransparency }),
        dist     = newDrawing("Text",   { Size = Config.TextSize, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
        distX    = newDrawing("Text",   { Size = Config.TextSize - 2, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
        distZ    = newDrawing("Text",   { Size = Config.TextSize - 2, Font = Config.TextFont, Center = true, Outline = Config.TextOutline, Visible = false, Color = Config.DistanceColor, Transparency = Config.TextTransparency }),
    }
    esp[plr] = e
    return e
end

local function clearEsp(plr)
    local e = esp[plr]
    if not e then return end
    for _, v in pairs(e) do
        if typeof(v) == "Drawing" then v:Remove()
        elseif type(v) == "table" then
            for _, l in pairs(v) do if typeof(l) == "Drawing" then l:Remove() end end
        end
    end
    esp[plr] = nil
end

-- ============================================================
-- RENDER
-- ============================================================
local function renderPlayer(plr)
    if plr == LocalPlayer then return end
    local char, hrp, head, hum = getCharacterParts(plr)
    if not char then
        local e = esp[plr]; if e then
            for _, v in pairs(e) do
                if typeof(v) == "Drawing" then v.Visible = false
                elseif type(v) == "table" then
                    for _, l in pairs(v) do if typeof(l) == "Drawing" then l.Visible = false end end
                end
            end
        end
        return
    end
    if Config.TeamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return end

    local myPos = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
                  and LocalPlayer.Character.HumanoidRootPart.Position
                  or Camera.CFrame.Position
    local dist = (hrp.Position - myPos).Magnitude
    if Config.MaxDistance > 0 and dist > Config.MaxDistance then return end
    if not visible(plr, hrp) then return end

    local e = ensureEsp(plr)

    local headScreen = screenPoint(head.Position)
    local hrpScreen  = screenPoint(hrp.Position)
    local headTop    = screenPoint(head.Position + Vector3.new(0, head.Size.Y * 0.5, 0))
    local feetBot    = screenPoint(hrp.Position - Vector3.new(0, hrp.Size.Y * 0.5 + 2.4, 0))

    if not (headScreen and hrpScreen and headTop and feetBot) then
        for _, v in pairs(e) do
            if typeof(v) == "Drawing" then v.Visible = false
            elseif type(v) == "table" then
                for _, l in pairs(v) do if typeof(l) == "Drawing" then l.Visible = false end end
            end
        end
        return
    end

    local x = math.min(headScreen.X, feetBot.X) - 6
    local y = headTop.Y - 4
    local w = math.max(math.abs(headScreen.X - feetBot.X) + 12, 24)
    local h = feetBot.Y - headTop.Y + 8

    -- BOX 2D
    e.box2d.Visible = Config.Box2D
    e.boxFill.Visible = Config.Box2D and Config.FillBox
    if Config.Box2D then
        e.box2d.Size = Vector2.new(w, h); e.box2d.Position = Vector2.new(x, y); e.box2d.Color = Config.BoxColor
        if Config.FillBox then
            e.boxFill.Size = Vector2.new(w, h); e.boxFill.Position = Vector2.new(x, y); e.boxFill.Color = Config.BoxColor
        end
    end

    -- BOX 3D
    local corners3 = {
        Vector3.new( hrp.Size.X/2,  hrp.Size.Y/2,  hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2,  hrp.Size.Y/2,  hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2, -hrp.Size.Y/2,  hrp.Size.Z/2),
        Vector3.new( hrp.Size.X/2, -hrp.Size.Y/2,  hrp.Size.Z/2),
        Vector3.new( hrp.Size.X/2,  hrp.Size.Y/2, -hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2,  hrp.Size.Y/2, -hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2, -hrp.Size.Y/2, -hrp.Size.Z/2),
        Vector3.new( hrp.Size.X/2, -hrp.Size.Y/2, -hrp.Size.Z/2),
    }
    local edges = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    if #e.box3d == 0 then
        for i = 1, 12 do e.box3d[i] = newDrawing("Line", { Thickness = 1, Visible = false, Color = Config.Box3DColor }) end
    end
    for i, ed in ipairs(edges) do
        local line = e.box3d[i]
        if Config.Box3D then
            local a = screenPoint(hrp.CFrame:PointToWorldSpace(corners3[ed[1]]))
            local b = screenPoint(hrp.CFrame:PointToWorldSpace(corners3[ed[2]]))
            if a and b then line.From = a; line.To = b; line.Visible = true; line.Color = Config.Box3DColor
            else line.Visible = false end
        else line.Visible = false end
    end

    -- SKELETON
    local skel = (hum.RigType == Enum.HumanoidRigType.R15) and SKEL_R15 or SKEL_R6
    if #e.skeleton == 0 then
        for i = 1, #skel do
            e.skeleton[i] = newDrawing("Line", { Thickness = 1.5, Visible = false, Color = Config.SkeletonColor })
        end
    end
    for i, pair in ipairs(skel) do
        local line = e.skeleton[i]
        if Config.Skeleton then
            local p1, p2 = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
            if p1 and p2 then
                local a, b = screenPoint(p1.Position), screenPoint(p2.Position)
                if a and b then line.From = a; line.To = b; line.Visible = true; line.Color = Config.SkeletonColor
                else line.Visible = false end
            else line.Visible = false end
        else line.Visible = false end
    end

    -- LINE
    e.line.Visible = Config.Line
    if Config.Line then
        e.line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        e.line.To   = Vector2.new(x + w/2, y + h)
        e.line.Color = Config.LineColor
    end

    -- HEALTH
    local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    local col  = healthColor(frac)

    e.hpVbg.Visible = Config.HealthBarVertical
    e.hpV.Visible   = Config.HealthBarVertical
    if Config.HealthBarVertical then
        local barX, barW = x - 6, 3
        e.hpVbg.Size = Vector2.new(barW, h); e.hpVbg.Position = Vector2.new(barX, y)
        local fillH = h * frac
        e.hpV.Size = Vector2.new(barW, fillH); e.hpV.Position = Vector2.new(barX, y + h - fillH); e.hpV.Color = col
    end
    e.hpHbg.Visible = Config.HealthBarHorizontal
    e.hpH.Visible   = Config.HealthBarHorizontal
    if Config.HealthBarHorizontal then
        local barY = y + h + 4
        e.hpHbg.Size = Vector2.new(w, 3); e.hpHbg.Position = Vector2.new(x, barY)
        e.hpH.Size = Vector2.new(w * frac, 3); e.hpH.Position = Vector2.new(x, barY); e.hpH.Color = col
    end

    -- HEAD DOT
    e.headDot.Visible = Config.HeadDot
    if Config.HeadDot then
        e.headDot.Position = Vector2.new(headScreen.X, headScreen.Y)
        e.headDot.Radius = 3
        e.headDot.Color = Config.BoxColor
    end

    -- NAME
    e.name.Visible = Config.NameTag
    if Config.NameTag then
        e.name.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
        e.name.Position = Vector2.new(x + w/2, y - 16)
        e.name.Color = Config.NameColor
    end

    -- DISTANCE
    e.dist.Visible = Config.DistanceText
    if Config.DistanceText then
        e.dist.Text = string.format("[%d studs]", math.floor(dist))
        e.dist.Position = Vector2.new(x + w/2, y + h + 6)
        e.dist.Color = Config.DistanceColor
    end
    e.distX.Visible = Config.DistanceAxes
    e.distZ.Visible = Config.DistanceAxes
    if Config.DistanceAxes then
        local dx = math.abs(hrp.Position.X - myPos.X)
        local dz = math.abs(hrp.Position.Z - myPos.Z)
        e.distX.Text = string.format("X:%d", math.floor(dx))
        e.distX.Position = Vector2.new(x + w/2, y + h + 22)
        e.distZ.Text = string.format("Z:%d", math.floor(dz))
        e.distZ.Position = Vector2.new(x + w/2, y + h + 34)
    end
end

