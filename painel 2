    Box2D=true,Box3D=false,Skeleton=true,Line=false,
    HealthBarVertical=true,HealthBarHorizontal=false,
    NameTag=true,DistanceText=true,DistanceAxes=false,FillBox=false,HeadDot=false,WeaponText=false,
    AimEnabled=false,AimKey=Enum.UserInputType.MouseButton2,AimSmooth=0.25,AimFOV=150,
