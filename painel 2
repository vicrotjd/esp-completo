local function slider(label,key,mn,mx,par,ord)
    local r=Instance.new("Frame") r.Size=UDim2.new(1,0,0,38) r.BackgroundTransparency=1 r.LayoutOrder=ord r.Parent=par
    local l=Instance.new("TextLabel") l.Size=UDim2.new(1,0,0,14) l.BackgroundTransparency=1 l.Text=label..": "..tostring(Cfg[key]) l.TextColor3=Cfg.PanelText l.Font=Enum.Font.Gotham l.TextSize=12 l.TextXAlignment=Enum.TextXAlignment.Left l.Parent=r
    local tr=Instance.new("Frame") tr.Size=UDim2.new(1,-10,0,4) tr.Position=UDim2.new(0,0,0,22) tr.BackgroundColor3=Color3.fromRGB(30,20,45) tr.BorderSizePixel=0 tr.Parent=r
    Instance.new("UICorner",tr).CornerRadius=UDim.new(1,0)
    local fl=Instance.new("Frame") fl.Size=UDim2.new((Cfg[key]-mn)/(mx-mn),0,1,0) fl.BackgroundColor3=Cfg.PanelAccent fl.BorderSizePixel=0 fl.Parent=tr
    Instance.new("UICorner",fl).CornerRadius=UDim.new(1,0)
    local drg=false
    local function setX(mx_)
        local ax=tr.AbsolutePosition.X local w=tr.AbsoluteSize.X
        local f=math.clamp((mx_-ax)/w,0,1) local v=math.floor(mn+f*(mx-mn))
        Cfg[key]=v l.Text=label..": "..tostring(v) fl.Size=UDim2.new(f,0,1,0)
    end
    tr.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drg=true setX(i.Position.X) end end)
    U.InputChanged:Connect(function(i) if drg and i.UserInputType==Enum.UserInputType.MouseMovement then setX(i.Position.X) end end)
    U.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drg=false end end)
end

