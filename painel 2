local highlights = {}
local function clearHighlight(plr)
    if highlights[plr] then
        pcall(function() highlights[plr]:Destroy() end)
        highlights[plr] = nil
    end
end

local function createHighlight(plr)
    local h = Instance.new("Highlight")
    h.Name = "MicaCham"
    h.FillColor = Cfg.ChamsFill
    h.OutlineColor = Cfg.ChamsOutline
    h.FillTransparency = 0.5
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = (gethui and gethui()) or C
    highlights[plr] = h
    return h
end

R.RenderStepped:Connect(function()
    for _, plr in ipairs(P:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local h = highlights[plr]

        if Cfg.ChamsEnabled and char and (not Cfg.TeamCheck or plr.Team ~= LP.Team) then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if not h then h = createHighlight(plr) end
                h.Adornee = char
                h.FillColor = Cfg.ChamsFill
                h.OutlineColor = Cfg.ChamsOutline
                h.Enabled = true
            else
                if h then h.Enabled = false end
            end
        else
            if h then h.Enabled = false end
        end
    end
end)

P.PlayerRemoving:Connect(clearHighlight)

local aimHeld = false
U.InputBegan:Connect(function(i,g) if not g and i.UserInputType==Cfg.AimKey then aimHeld=true end end)
U.InputEnded:Connect(function(i) if i.UserInputType==Cfg.AimKey then aimHeld=false end end)

local function getAimTarget()
    local m = U:GetMouseLocation()
    local best, bd = nil, Cfg.AimFOV
    for _, plr in ipairs(P:GetPlayers()) do
        if plr ~= LP and (not Cfg.TeamCheck or plr.Team ~= LP.Team) then
            local char = plr.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local targetPart
                if Cfg.AimPart == "Head" then targetPart = char:FindFirstChild("Head")
                elseif Cfg.AimPart == "UpperTorso" then targetPart = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                else targetPart = char:FindFirstChild("HumanoidRootPart") end
                
                if hum and hum.Health > 0 and targetPart then
                    local sp, on = Cam:WorldToViewportPoint(targetPart.Position)
                    if on then
                        local d = (m - Vector2.new(sp.X, sp.Y)).Magnitude
                        if d < bd then
                            best = targetPart
                            bd = d
                        end
                    end
                end
            end
        end
    end
    return best
end

R.RenderStepped:Connect(function()
    if not Cfg.AimEnabled or not aimHeld then return end
    local target = getAimTarget()
    if target then
        -- Rage: Lock instantâneo, sem lerp, sem prediction.
        Cam.CFrame = CFrame.lookAt(Cam.CFrame.Position, target.Position)
    end
end)

