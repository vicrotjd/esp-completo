local function d(class) return Drawing.new(class) end
local function parts(plr)
    local c=plr.Character if not c then return end
    local h=c:FindFirstChild("HumanoidRootPart")
    local hd=c:FindFirstChild("Head")
    local hm=c:FindFirstChildOfClass("Humanoid")
    if h and hd and hm and hm.Health>0 then return c,h,hd,hm end
end
local function w2s(pos)
    local sp,on=Cam:WorldToViewportPoint(pos)
    if not on then return end
    local v=Cam.ViewportSize
    if sp.X<0 or sp.X>v.X or sp.Y<0 or sp.Y>v.Y then return end
    return Vector2.new(sp.X,sp.Y)
end
local visParams=RaycastParams.new()
visParams.FilterType=Enum.RaycastFilterType.Exclude
local function visible(plr,hrp)
    if not Cfg.VisibleCheck then return true end
    visParams.FilterDescendantsInstances={LP.Character,hrp.Parent}
    local r=W:Raycast(Cam.CFrame.Position,hrp.Position-Cam.CFrame.Position,visParams)
    return r==nil or r.Instance:IsDescendantOf(hrp.Parent)
end
local function hpCol(f) f=math.clamp(f,0,1) return Color3.new(1-f,f,0) end

local SK6={{"Head","Torso"},{"Torso","HumanoidRootPart"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
local SK15={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}

local esp={}

local function hide(e) if not e then return end
    for _,v in pairs(e) do
        if typeof(v)=="Drawing" then v.Visible=false
        elseif type(v)=="table" then for _,l in pairs(v) do if typeof(l)=="Drawing" then l.Visible=false end end end
    end
end
local function killEsp(plr)
    local e=esp[plr] if not e then return end
    for _,v in pairs(e) do
        if typeof(v)=="Drawing" then pcall(function() v:Remove() end)
        elseif type(v)=="table" then for _,l in pairs(v) do if typeof(l)=="Drawing" then pcall(function() l:Remove() end) end end end
    end
    esp[plr]=nil
end
local function mk(plr)
    local e={
        box2d=d("Square"),boxFill=d("Square"),box3d={},skeleton={},
        line=d("Line"),hpV=d("Square"),hpVbg=d("Square"),hpH=d("Square"),hpHbg=d("Square"),
        headDot=d("Circle"),name=d("Text"),dist=d("Text"),distX=d("Text"),distZ=d("Text"),weapon=d("Text"),
    }
    e.box2d.Thickness=1 e.boxFill.Filled=true e.boxFill.Transparency=0.75 e.boxFill.Visible=false
    e.hpV.Filled=true e.hpVbg.Filled=true e.hpVbg.Color=Color3.new(0,0,0)
    e.hpH.Filled=true e.hpHbg.Filled=true e.hpHbg.Color=Color3.new(0,0,0)
    e.headDot.Filled=true
    for _,t in ipairs({e.name,e.dist,e.distX,e.distZ,e.weapon}) do
        t.Center=true t.Outline=Cfg.TextOutline t.Font=Cfg.TextFont t.Transparency=Cfg.TextTransparency
    end
    e.name.Size=Cfg.TextSize e.dist.Size=Cfg.TextSize
    e.distX.Size=Cfg.TextSize-2 e.distZ.Size=Cfg.TextSize-2 e.weapon.Size=Cfg.TextSize-2
    e.name.Color=Cfg.NameColor e.dist.Color=Cfg.DistanceColor e.distX.Color=Cfg.DistanceColor e.distZ.Color=Cfg.DistanceColor
    esp[plr]=e return e
end

local aimHeld=false
U.InputBegan:Connect(function(i,g) if not g and i.UserInputType==Cfg.AimKey then aimHeld=true end end)
U.InputEnded:Connect(function(i) if i.UserInputType==Cfg.AimKey then aimHeld=false end end)

local aimParams=RaycastParams.new()
aimParams.FilterType=Enum.RaycastFilterType.Exclude

local function aimTarget()
    local m=U:GetMouseLocation() local best,bd=nil,Cfg.AimFOV
    for _,plr in ipairs(P:GetPlayers()) do
        if plr~=LP and (not Cfg.TeamCheck or plr.Team~=LP.Team) then
            local c,hrp,hd,hm=parts(plr)
            if c and (not Cfg.AimVisibleOnly or visible(plr,hrp)) then
                local tp=Cfg.AimPart=="Head" and hd or Cfg.AimPart=="UpperTorso" and (c:FindFirstChild("UpperTorso") or hrp) or hrp
                local sp=w2s(tp.Position)
                if sp then
                    local d=(m-sp).Magnitude
                    if d<bd then
                        local ok=true
                        if Cfg.AimWallCheck then
                            aimParams.FilterDescendantsInstances={LP.Character,c}
                            ok=W:Raycast(Cam.CFrame.Position,tp.Position-Cam.CFrame.Position,aimParams)==nil
                        end
                        if ok then best={part=tp,pos=tp.Position} bd=d end
                    end
                end
            end
        end
    end
    return best
end

R.RenderStepped:Connect(function()
    if not Cfg.Enabled or not Cfg.AimEnabled or not aimHeld then return end
    local t=aimTarget() if not t then return end
    local p=t.pos
    if Cfg.AimPrediction>0 then p=p+(t.part.AssemblyLinearVelocity*Cfg.AimPrediction) end
    local cf=CFrame.lookAt(Cam.CFrame.Position,p)
    Cam.CFrame=Cam.CFrame:Lerp(cf,1-Cfg.AimSmooth)
end)

local function render(plr)
    if plr==LP then return end
    local c,hrp,hd,hm=parts(plr)
    local e=esp[plr]
    if not c then hide(e) return end
    if Cfg.TeamCheck and LP.Team and plr.Team==LP.Team then hide(e) return end
    local mc=LP.Character local mh=mc and mc:FindFirstChild("HumanoidRootPart")
    local mp=mh and mh.Position or Cam.CFrame.Position
    local dist=(hrp.Position-mp).Magnitude
    if Cfg.MaxDistance>0 and dist>Cfg.MaxDistance then hide(e) return end
    if not visible(plr,hrp) then hide(e) return end

    e=e or mk(plr)
    local hs=w2s(hd.Position) local ht=w2s(hd.Position+Vector3.new(0,hd.Size.Y*0.5,0))
    local fb=w2s(hrp.Position-Vector3.new(0,hrp.Size.Y*0.5+2.4,0))
    if not (hs and ht and fb) then hide(e) return end

    local x=math.min(hs.X,fb.X)-6 local y=ht.Y-4
    local w=math.max(math.abs(hs.X-fb.X)+12,24) local h=fb.Y-ht.Y+8

    e.box2d.Visible=Cfg.Box2D
    e.boxFill.Visible=Cfg.Box2D and Cfg.FillBox
    if Cfg.Box2D then
        e.box2d.Size=Vector2.new(w,h) e.box2d.Position=Vector2.new(x,y) e.box2d.Color=Cfg.BoxColor
        if Cfg.FillBox then e.boxFill.Size=Vector2.new(w,h) e.boxFill.Position=Vector2.new(x,y) e.boxFill.Color=Cfg.BoxColor end
    end

    local cs={
        Vector3.new(hrp.Size.X/2,hrp.Size.Y/2,hrp.Size.Z/2),Vector3.new(-hrp.Size.X/2,hrp.Size.Y/2,hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2,-hrp.Size.Y/2,hrp.Size.Z/2),Vector3.new(hrp.Size.X/2,-hrp.Size.Y/2,hrp.Size.Z/2),
        Vector3.new(hrp.Size.X/2,hrp.Size.Y/2,-hrp.Size.Z/2),Vector3.new(-hrp.Size.X/2,hrp.Size.Y/2,-hrp.Size.Z/2),
        Vector3.new(-hrp.Size.X/2,-hrp.Size.Y/2,-hrp.Size.Z/2),Vector3.new(hrp.Size.X/2,-hrp.Size.Y/2,-hrp.Size.Z/2),
    }
    local eds={{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    if #e.box3d==0 then for i=1,12 do local l=d("Line") l.Thickness=1 l.Visible=false l.Color=Cfg.Box3DColor e.box3d[i]=l end end
    for i,ed in ipairs(eds) do
        local l=e.box3d[i]
        if Cfg.Box3D then
            local a=w2s(hrp.CFrame:PointToWorldSpace(cs[ed[1]]))
            local b=w2s(hrp.CFrame:PointToWorldSpace(cs[ed[2]]))
            if a and b then l.From=a l.To=b l.Visible=true l.Color=Cfg.Box3DColor else l.Visible=false end
        else l.Visible=false end
    end

    local skel=hm.RigType==Enum.HumanoidRigType.R15 and SK15 or SK6
    if #e.skeleton<#skel then for i=#e.skeleton+1,#skel do local l=d("Line") l.Thickness=1.5 l.Visible=false l.Color=Cfg.SkeletonColor e.skeleton[i]=l end end
    for i,pair in ipairs(skel) do
        local l=e.skeleton[i]
        if Cfg.Skeleton then
            local p1,p2=c:FindFirstChild(pair[1]),c:FindFirstChild(pair[2])
            if p1 and p2 then
                local a,b=w2s(p1.Position),w2s(p2.Position)
                if a and b then l.From=a l.To=b l.Visible=true l.Color=Cfg.SkeletonColor else l.Visible=false end
            else l.Visible=false end
        else l.Visible=false end
    end

    e.line.Visible=Cfg.Line
    if Cfg.Line then e.line.From=Vector2.new(Cam.ViewportSize.X/2,Cam.ViewportSize.Y) e.line.To=Vector2.new(x+w/2,y+h) e.line.Color=Cfg.LineColor end

    local f=math.clamp(hm.Health/hm.MaxHealth,0,1) local col=hpCol(f)
    e.hpVbg.Visible=Cfg.HealthBarVertical e.hpV.Visible=Cfg.HealthBarVertical
    if Cfg.HealthBarVertical then
        local bx=e.box2d.Position.X-6
        e.hpVbg.Size=Vector2.new(3,h) e.hpVbg.Position=Vector2.new(bx,y)
        local fh=h*f
        e.hpV.Size=Vector2.new(3,fh) e.hpV.Position=Vector2.new(bx,y+h-fh) e.hpV.Color=col
    end
    e.hpHbg.Visible=Cfg.HealthBarHorizontal e.hpH.Visible=Cfg.HealthBarHorizontal
    if Cfg.HealthBarHorizontal then
        local by=y+h+4
        e.hpHbg.Size=Vector2.new(w,3) e.hpHbg.Position=Vector2.new(x,by)
        e.hpH.Size=Vector2.new(w*f,3) e.hpH.Position=Vector2.new(x,by) e.hpH.Color=col
    end

    e.headDot.Visible=Cfg.HeadDot
    if Cfg.HeadDot then e.headDot.Position=Vector2.new(hs.X,hs.Y) e.headDot.Radius=3 e.headDot.Color=Cfg.BoxColor end

    e.name.Visible=Cfg.NameTag
    if Cfg.NameTag then e.name.Text=plr.DisplayName.." (@"..plr.Name..")" e.name.Position=Vector2.new(x+w/2,y-16) e.name.Color=Cfg.NameColor end

    e.dist.Visible=Cfg.DistanceText
    if Cfg.DistanceText then e.dist.Text=string.format("[%d studs]",math.floor(dist)) e.dist.Position=Vector2.new(x+w/2,y+h+6) e.dist.Color=Cfg.DistanceColor end

    e.distX.Visible=Cfg.DistanceAxes e.distZ.Visible=Cfg.DistanceAxes
    if Cfg.DistanceAxes then
        e.distX.Text=string.format("X:%d",math.floor(math.abs(hrp.Position.X-mp.X))) e.distX.Position=Vector2.new(x+w/2,y+h+22)
        e.distZ.Text=string.format("Z:%d",math.floor(math.abs(hrp.Position.Z-mp.Z))) e.distZ.Position=Vector2.new(x+w/2,y+h+34)
    end

    e.weapon.Visible=Cfg.WeaponText
    if Cfg.WeaponText then
        local tool=c:FindFirstChildOfClass("Tool")
        if tool then e.weapon.Text=tool.Name e.weapon.Position=Vector2.new(x+w/2,y+h+50)
        else e.weapon.Visible=false end
    end
end

